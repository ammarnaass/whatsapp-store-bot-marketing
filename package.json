    "build": "npm run build:renderer && npm run build:main",
    "dev:vite": "node scripts/build-css.mjs && vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
